# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
# Option A: Full Connection String (Recommended for Supabase, Neon, Render, RDS)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samarthya_core_db

# Option B: Individual Host Credentials
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=samarthya_core_db
PG_USER=postgres
PG_PASSWORD=postgres

# JWT Authentication
ACCESS_TOKEN_SECRET=samarthya-access-token-secret-key-2026-cfg
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=samarthya-refresh-token-secret-key-2026-cfg
REFRESH_TOKEN_EXPIRY=10d

# Cloud Storage (for grievance photos, audio recordings, stamped physical receipts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech-to-Text & AI Model Configuration (OpenAI Whisper / Bhashini / HuggingFace)
SPEECH_TO_TEXT_API_KEY=
OPENAI_API_KEY=

# Multi-Channel Notification Dispatcher (Twilio / Fast2SMS / Gupshup for WhatsApp & SMS)
SMS_API_KEY=
WHATSAPP_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
